# ------------------------------------------------------------------
# HisabMitra website configuration
# Copy to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.
#
# All values are optional. Anything left empty is hidden gracefully —
# the site never shows placeholder or invented contact details.
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.
# ------------------------------------------------------------------

# Canonical production URL (no trailing slash). Used for canonical tags,
# Open Graph URLs, sitemap.xml and robots.txt.
# If empty on Vercel, the project's production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Public business email. Enables the "Email us" mailto link.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional social profiles (must be full https:// URLs).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
