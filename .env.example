# ------------------------------------------------------------------
# HisabMitra — environment variables
#
# Local:   copy this file to .env.local and fill in the values.
# Hosting: add the same keys in your host's environment settings.
#
# NEVER commit real values. .env.local is git-ignored.
# NEXT_PUBLIC_* values are visible in the browser and are inlined at build
# time (redeploy after changing them). Everything else stays on the server.
# Full walkthrough: docs/SETUP.md
# ------------------------------------------------------------------

# ===== REQUIRED: Supabase =====
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" (or legacy "anon") key. Safe for the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The "secret" (or legacy "service_role") key. SERVER ONLY — bypasses Row Level Security.
# Needed for: admin bootstrap, daily job, bill fetch, WhatsApp sending.
SUPABASE_SERVICE_ROLE_KEY=

# ===== REQUIRED: Admin =====
# The ONE email that becomes admin on its first verified login. Nobody else can become admin.
ADMIN_EMAIL=

# Any long random string. Protects /api/cron/* (Vercel Cron sends it automatically).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ===== Website =====
# Canonical production URL, no trailing slash (used for SEO tags and auth redirects).
NEXT_PUBLIC_SITE_URL=
# Optional public contact details for the marketing site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# ===== OPTIONAL: WhatsApp Cloud API (Meta) =====
# Leave empty until you have a WhatsApp Business Account and an APPROVED template.
# While empty, owners get "Copy message" / "Open in WhatsApp" instead of automatic sending.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Exact name and language code of the approved template (see docs/SETUP.md for the template text).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# For delivery receipts (webhook): Meta app secret + any random string you also enter in Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v21.0

# ===== OPTIONAL: BBPS electricity bills (Setu BillPay) =====
# Leave empty until BillPay onboarding is approved. The live adapter is intentionally
# not wired yet (src/lib/electricity/setu-provider.ts) — see docs/SETUP.md.
SETU_BILLPAY_BASE_URL=
SETU_BILLPAY_CLIENT_ID=
SETU_BILLPAY_CLIENT_SECRET=
# JSON from the provider's biller catalogue, e.g. {"PVVNL":{"billerId":"...","customerParam":"..."}}
SETU_BILLPAY_BILLER_MAP=
